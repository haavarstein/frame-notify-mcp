# At least 16 characters. Generate one with: openssl rand -hex 24
# Leave this empty and the notify endpoints answer 404.
FRAME_NOTIFY_TOKEN=

# Loopback by default. Set FRAME_HOST=0.0.0.0 only on a trusted LAN.
# GET /api/alerts has no token, so an open host lets the LAN read alert text.
FRAME_HOST=127.0.0.1
FRAME_PORT=8090
